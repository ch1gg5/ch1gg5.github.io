<article class="schematic-panel project-card">
  <span class="reg-mark tl"></span><span class="reg-mark tr"></span>
  <span class="reg-mark bl"></span><span class="reg-mark br"></span>
  <div class="panel-header">
    <span class="panel-path">{{ project.path }}</span>
    {% if project.date %}<span class="panel-meta">{{ project.date }}</span>{% endif %}
  </div>
  <div class="panel-body">
    <h3>{{ project.title }}</h3>
    <p>{{ project.description }}</p>
    <div class="panel-tags">
      {% for tag in project.tags %}<span>{{ tag }}</span>{% endfor %}
    </div>
    <div class="panel-links">
      {% for link in project.links %}
        <a href="{{ link.url }}" class="card-link" target="_blank" rel="noopener">&lt;&gt; {{ link.label }}</a>
      {% else %}
        <span class="card-link card-link-muted">&lt;&gt; Private repo</span>
      {% endfor %}
    </div>
  </div>
</article>
