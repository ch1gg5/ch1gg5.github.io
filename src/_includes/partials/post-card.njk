<article class="schematic-panel post-card">
  <span class="reg-mark tl"></span><span class="reg-mark tr"></span>
  <span class="reg-mark bl"></span><span class="reg-mark br"></span>
  <div class="panel-header">
    <span class="panel-path">LOG #{{ collections.posts | logNumber(post) }}</span>
    <span class="panel-meta">{{ post.date | postDate }} · {{ post.templateContent | readingTime }}</span>
  </div>
  <div class="panel-body">
    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    <p>{{ post.data.description }}</p>
    <div class="panel-links">
      <a href="{{ post.url }}" class="card-link">Read entry →</a>
    </div>
  </div>
</article>
